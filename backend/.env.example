# Copy to backend/.env for local development. In Azure these are App Service app settings.
APP_ENV=local
AUTH_MODE=dev
DEV_USER_EMAIL=dev.user@ges.com
DEV_USER_NAME=Dev User
DEV_USER_ROLES=Admin
# Leave GRAPH_* empty locally: emails are written to backend/data/outbox instead of being sent.
GRAPH_APP_ID=
GRAPH_TENANT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHARED_MAILBOX=
SP_SITE_URL=
SP_LISTS_PATH=
BLOB_ACCOUNT_URL=
